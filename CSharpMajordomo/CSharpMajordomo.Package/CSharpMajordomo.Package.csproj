<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>CSharpMajordomo.Analyzer</PackageId>
    <PackageVersion>0.1.0.0-alpha</PackageVersion>
    <Authors>Glen Nicol</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/glen-nicol/CSharpMajordomo</PackageProjectUrl>
    <RepositoryUrl>https://github.com/glen-nicol/CSharpMajordomo</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <Description>This analyzer helps organize C# files similar to how the CodeMaid extension could sort files.</Description>
    <PackageReleaseNotes>Initial release</PackageReleaseNotes>
    <Copyright>Copyright 2026</Copyright>
    <PackageTags>C#, analyzers, code quality, Style</PackageTags>
    <DevelopmentDependency>true</DevelopmentDependency>

    <!-- Instructs the build to store symbols inside the main DLL because analyzers don't have good support for snupkg. Get NU5017: Cannot create a package that has no dependencies nor content. -->
    <DebugType>embedded</DebugType>

    <!-- Disables the creation of a separate .snupkg file to bypass NU5017 -->
    <IncludeSymbols>false</IncludeSymbols>

    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);_AddAnalyzersToOutput</TargetsForTfmSpecificContentInPackage>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\CSharpMajordomo.CodeFixes\CSharpMajordomo.CodeFixes.csproj" />
    <ProjectReference Include="..\CSharpMajordomo\CSharpMajordomo.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="tools\*.ps1" CopyToOutputDirectory="PreserveNewest" Pack="true" PackagePath="" />
    <None Include="..\..\readme.md" Pack="true" PackagePath="\README.md" />
  </ItemGroup>

  <Target Name="_AddAnalyzersToOutput">
    <ItemGroup>
      <TfmSpecificPackageFile Include="$(OutputPath)\CSharpMajordomo.dll" PackagePath="analyzers/dotnet/cs" />
      <TfmSpecificPackageFile Include="$(OutputPath)\CSharpMajordomo.CodeFixes.dll" PackagePath="analyzers/dotnet/cs" />
    </ItemGroup>
  </Target>

</Project>
